BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=

# Optional: where to create/find the Raffle folder. Defaults to All Files root.
BOX_PARENT_FOLDER_ID=0

# Optional: defaults to "Raffle".
BOX_RAFFLE_FOLDER_NAME=Raffle

# Required to email entrants after submission.
RESEND_API_KEY=

# Recommended in production: a sender on your verified Resend domain.
# Defaults to "Box Raffle <onboarding@resend.dev>" for testing.
RESEND_FROM_EMAIL=

# Required for protected admin routes (pass the same value in the X-Secret header):
#   GET  /api/box/entries-csv
#   DELETE /api/box/raffle-files
SECRET=
